# Copy this file to .env and fill in your own key. Never commit .env.
#
# Required for multilingual translation (i18n/translate.py::OpenRouterTranslator)
# AND for the "listen" button's speech output (i18n/tts.py, via
# voice_prototype/server.py's /speak route - openai/gpt-audio through
# OpenRouter). Not required to run the Arabic-only RAG (agent/agent.py)
# or the offline test suite.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
