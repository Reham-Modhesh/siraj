# Copy this file to .env and fill in your own key. Never commit .env.
#
# Required for multilingual translation (i18n/translate.py::OpenRouterTranslator).
# Not required to run the Arabic-only RAG (agent/agent.py) or the offline test suite.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Required for the "listen" button's speech output (i18n/tts.py, via
# voice_prototype/server.py's /speak route). This is a *different* key
# from OPENROUTER_API_KEY above - Gemini's audio-output modality is
# called directly against Google's Generative Language API, not through
# OpenRouter. Get one at https://aistudio.google.com/apikey. Not required
# to run anything else in this repo.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
